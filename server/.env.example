JWT_SECRET=replace-with-at-least-32-characters
PORT=3002
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=replace-me
DB_NAME=dianxiaoer

# 仓库商品图片保存到业务程序目录之外，避免发布代码时覆盖。
DXE_DATA_DIR=C:/dianxiaoer-data
# 可选：存在 HTTPS 反向代理或正式域名时填写；留空则按当前请求地址生成图片 URL。
INVENTORY_IMAGE_PUBLIC_BASE_URL=

# 云仓助手第三方服务使用公开 HTTPS v1 接口，不配置接口密钥。
CLOUD_WAREHOUSE_API_BASE_URL=https://150.158.54.108:3443
# 使用标准 HTTPS CA 信任链和 IP SAN 校验；禁止关闭证书校验。
CLOUD_WAREHOUSE_API_TIMEOUT_MS=10000

# 短信接口凭据仅配置在业务服务器，禁止写入 Electron 客户端代码。
SMS_PROVIDER_URL=https://apis.shlianlu.com/sms/trade/normal/send
SMS_PROVIDER_APP_ID=
SMS_PROVIDER_MCH_ID=
SMS_PROVIDER_KEY=
SMS_DEFAULT_SIGN_NAME=【宿迁小灰狼电子商务】
SMS_REQUEST_TIMEOUT_MS=12000
